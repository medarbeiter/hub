{"nodes": [{"id": "docs_superpowers_specs_2026_08_14_coolify_docker_design_single_container_architecture", "label": "Single-Container Coolify Architecture", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-14-coolify-docker-design.md", "source_location": "Gew\u00e4hlter Ansatz", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single multi-stage Bun container plus Compose is sufficient; there is no initializer service, separate database, host port or hand-written Traefik routing."}, {"id": "docs_superpowers_specs_2026_08_14_coolify_docker_design_standalone_runtime_image", "label": "Next.js Standalone Runtime Image", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-14-coolify-docker-design.md", "source_location": "Container-Abbild", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_14_coolify_docker_design_idempotent_admin_bootstrap", "label": "Idempotent Administrator Bootstrap", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-14-coolify-docker-design.md", "source_location": "Erststart und Migrationen", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The first start creates exactly one administrator only when users is empty; all later starts leave account and password data untouched."}, {"id": "docs_superpowers_specs_2026_08_14_coolify_docker_design_database_readiness_healthcheck", "label": "Database Readiness Healthcheck", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-14-coolify-docker-design.md", "source_location": "Healthcheck und Fehlerverhalten", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_14_coolify_docker_design_coolify_managed_traefik", "label": "Coolify-Managed Traefik and TLS", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-08-14-coolify-docker-design.md", "source_location": "Traefik und Domain", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Normal Coolify Compose deployment attaches the proxy and manages the domain, certificates and HTTPS redirect, so Compose intentionally omits proxy labels and published host ports."}, {"id": "docs_superpowers_specs_2026_08_14_coolify_docker_design_persistent_data_contract", "label": "Persistent /app/data Contract", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-08-14-coolify-docker-design.md", "source_location": "Persistente Daten", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_08_14_coolify_docker_design_single_container_architecture", "target": "docs_superpowers_specs_2026_08_14_coolify_docker_design_standalone_runtime_image", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-14-coolify-docker-design.md", "source_location": "Gew\u00e4hlter Ansatz and Container-Abbild", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_14_coolify_docker_design_single_container_architecture", "target": "docs_superpowers_specs_2026_08_14_coolify_docker_design_coolify_managed_traefik", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-14-coolify-docker-design.md", "source_location": "Gew\u00e4hlter Ansatz and Traefik und Domain", "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_14_coolify_docker_design_persistent_data_contract", "target": "docker_compose_medarbeiter_data_volume", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-14-coolify-docker-design.md", "source_location": "Persistente Daten", "weight": 1.0}, {"source": "docs_