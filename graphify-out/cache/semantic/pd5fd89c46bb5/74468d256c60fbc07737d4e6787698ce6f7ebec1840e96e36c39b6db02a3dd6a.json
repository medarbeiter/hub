{"nodes": [{"id": "design_gold_is_work_rule", "label": "Gold-Is-Work Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Colors: Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Brand gold has one semantic meaning\u2014worked time and the primary action\u2014so it cannot also encode status, warnings, money or decoration."}, {"id": "design_gold_needs_edge_rule", "label": "Gold-Needs-An-Edge Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Colors: Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixed brand gold cannot reach 3:1 on light grounds, so a bronze inset hairline supplies the perceptible boundary for every meaning-carrying gold surface."}, {"id": "design_two_stones_rule", "label": "Two-Stones Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Colors: Named Rules", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two classes of non-work information are separated by lightness within the stone palette instead of inventing an additional hue."}, {"id": "design_one_frame_rule", "label": "One-Frame Rule", "file_type": "rationale", "source_file": "DESIGN.md", "source_location": "Layout", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A route changes the contents of Kopf, B\u00fchne, Belege and rail but never their topology, keeping employee and management surfaces in one product grammar."}, {"id": "design_one_timeline_grammar", "label": "One Timeline Grammar", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Tagesbahn signature", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_one_month_grid", "label": "One Month Grid", "file_type": "concept", "source_file": "DESIGN.md", "source_location": "Monatsgitter signatu