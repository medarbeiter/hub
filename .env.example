# Wie die Anwendung von außen heißt — im Betrieb hub.med-arbeiter.de.
#
# Ein Wert, zwei Aufgaben, und beide brauchen dieselbe Adresse: die
# Weiterleitung nach der Google-Anmeldung (`<APP_URL>/api/google/callback`)
# und die Knöpfe in den E-Mails.
#
# **In der Entwicklung bleibt die Zeile auskommentiert.** Gesetzt schickte sie
# den lokalen OAuth-Rücksprung auf die Produktivadresse, und Links in
# Testnachrichten zeigten auf localhost — beides schlimmer als der Verzicht:
# ohne APP_URL nimmt die Anmeldung den gesehenen Origin, und eine Nachricht
# trägt schlicht keinen Knopf.
# APP_URL=https://hub.med-arbeiter.de

# Google-Anbindung (siehe README, Abschnitt „Google-Anbindung").
# OAuth-Client vom Typ „Webanwendung" aus der Google Cloud Console;
# Weiterleitungs-URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nur Entwicklung ohne Zugangsdaten: simulierten Verbinden-Knopf freischalten.
# MOCK_GOOGLE_OAUTH=1

# Resend — der E-Mail-Versand (siehe README, Abschnitt „E-Mail-Versand").
# Ohne Schlüssel verschickt die Anwendung nichts und schreibt jede Nachricht
# nur in die Konsole; alles andere funktioniert unverändert weiter.
RESEND_API_KEY=
