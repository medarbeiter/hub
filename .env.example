# Docker Compose / Coolify
# In Produktion die exakte Coolify-HTTPS-Domain einsetzen. Ein Wert dient
# zugleich dem Google-Rücksprung (`<APP_URL>/api/google/callback`) und den
# Knöpfen in E-Mails. Passwörter mit `$` in Coolify als „Literal“ markieren.
APP_URL=http://localhost:3000
ADMIN_EMAIL=verwaltung@example.de
ADMIN_NAME=Erste Verwaltung
ADMIN_PASSWORD=BitteSicherAendern2026

# Google-Anbindung (siehe README, Abschnitt „Google-Anbindung").
# OAuth-Client vom Typ „Webanwendung" aus der Google Cloud Console;
# Weiterleitungs-URI: <APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nur Entwicklung ohne Zugangsdaten: simulierten Verbinden-Knopf freischalten.
# MOCK_GOOGLE_OAUTH=1

# Resend — der E-Mail-Versand (siehe README, Abschnitt „E-Mail-Versand").
# Ohne Schlüssel verschickt die Anwendung nichts und schreibt jede Nachricht
# nur in die Konsole; alles andere funktioniert unverändert weiter.
RESEND_API_KEY=
