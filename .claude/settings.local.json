{
  "permissions": {
    "allow": [
      "Bash(bun *)",
      "Bash(bunx *)",
      "Bash(sips -c 240 240 --cropOffset 5 20 assets/logo.png --out public/logo-mark.png)",
      "Bash(sips -z 96 96 public/logo-mark.png --out public/logo-mark.png)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/login)",
      "Bash(curl -s http://localhost:3000/login)",
      "Bash(python3 *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"/Users/jessicapeneva/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"/Users/jessicapeneva/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"/Users/jessicapeneva/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"/Users/jessicapeneva/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write/MultiEdit on UI files, full-rule deep pass on Stop."
}
